{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to FastAPI Backend",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/back-end",
                    "remoteRoot": "/app"
                }
            ]
        }
    ]
}
